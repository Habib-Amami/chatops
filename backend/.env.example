APP_ENVIRONMENT=development
LOG_LEVEL=INFO

MODEL_PROVIDER=groq
# ChatOps requires a conversational model with local tool-calling support.
MODEL_NAME=qwen/qwen3.6-27b
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=0
AGENT_TIMEOUT_SECONDS=45

# LocalStack
AWS_TARGET=localstack
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
ALLOW_REAL_AWS=false

# Minikube. List values use JSON syntax.
KUBERNETES_TARGET=minikube
KUBERNETES_CONTEXT=minikube
KUBERNETES_IN_CLUSTER=false
KUBECONFIG=~/.kube/config
KUBERNETES_ALLOWED_NAMESPACES=["default","chatops-demo"]
# Standalone Pods may use any public image from these trusted registries.
KUBERNETES_DEFAULT_POD_REGISTRY=docker.io
KUBERNETES_ALLOWED_POD_REGISTRIES=["docker.io","ghcr.io","quay.io"]
KUBERNETES_REGISTRY_CHECK_TIMEOUT_SECONDS=5
KUBERNETES_POD_VERIFICATION_TIMEOUT_SECONDS=30
KUBERNETES_POD_VERIFICATION_POLL_SECONDS=1
ALLOW_REAL_KUBERNETES=false
