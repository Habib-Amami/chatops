# LangGraph Configuration
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=agent

# Kubernetes dashboard embedded beside the chat interface.
# Keep Headlamp and the frontend on the same hostname for iframe authentication.
# Start this URL with: kubectl port-forward -n headlamp service/headlamp 4466:80
NEXT_PUBLIC_HEADLAMP_URL=http://localhost:4466

# Production LangGraph configuration through the server-side API proxy.
# NEXT_PUBLIC_API_URL=/api
# LANGGRAPH_API_URL="https://my-agent.default.us.langgraph.app"
# Do NOT prefix this with NEXT_PUBLIC_. It must remain server-side.
# LANGSMITH_API_KEY="lsv2_..."
